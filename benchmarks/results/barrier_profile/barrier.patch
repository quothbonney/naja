+Eigen::MatrixXd rotate_matrix_gpu(const Eigen::MatrixXd& A, const Eigen::MatrixXd& Q) {
+    const int m = static_cast<int>(A.rows());
+    const int d = static_cast<int>(A.cols());
+    if (Q.rows() != d || Q.cols() != d) throw std::invalid_argument("rotation shape mismatch");
+    naja::gpu::DMatrix<double> A_d = [&]() {
+        naja::profiling::BarrierSpan span("rotation.upload_A");
+        return naja::gpu::DMatrix<double>(A);
+    }();
+    naja::gpu::DMatrix<double> Q_d(Q);
+    naja::gpu::DMatrix<double> C_d(m, d);
+    cublasHandle_t handle;
+    const auto status = cublasCreate(&handle);
+    if (status != CUBLAS_STATUS_SUCCESS) throw std::runtime_error("rotation cublasCreate failed");
+    {
+        naja::profiling::BarrierSpan span("rotation.dgemm_and_wait");
+        const double alpha = 1.0, beta = 0.0;
+        const auto result = cublasDgemm(handle, CUBLAS_OP_N, CUBLAS_OP_N,
+            m, d, d, &alpha, A_d.dmat, m, Q_d.dmat, d, &beta, C_d.dmat, m);
+        if (result != CUBLAS_STATUS_SUCCESS) {
+            cublasDestroy(handle);
+            throw std::runtime_error("rotation cublasDgemm failed");
+        }
+        const auto sync = cudaDeviceSynchronize();
+        if (sync != cudaSuccess) {
+            cublasDestroy(handle);
+            throw std::runtime_error(cudaGetErrorString(sync));
+        }
+    }
+    cublasDestroy(handle);
+    Eigen::MatrixXd out = [&]() {
+        naja::profiling::BarrierSpan span("rotation.download_A");
+        return C_d.toHost();
+    }();
+    if (std::getenv("NAJA_BARRIER_VALIDATE_ROTATION")) {
+        naja::profiling::BarrierSpan span("rotation.validation_not_for_timing");
+        Eigen::MatrixXd reference = A * Q;
+        const double relative = (reference-out).norm() / std::max(reference.norm(), 1e-300);
+        const double maximum = (reference-out).cwiseAbs().maxCoeff();
+        std::cerr << "NAJA_ROTATION_VALIDATION {\"relative_frobenius\":" << std::setprecision(17)
+                  << relative << ",\"maximum_absolute\":" << maximum << "}\n";
+        if (!out.allFinite() || relative > 1e-10) throw std::runtime_error("GPU rotation algebra check failed");
+    }
+    return out;
+}
